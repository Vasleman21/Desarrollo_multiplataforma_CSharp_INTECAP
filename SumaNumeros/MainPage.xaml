<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SumaNumeros.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <Button Text="Generar números"
                    Clicked="generarSecuencia"/>
            <Label
                x:Name="cajaTotal"/>
            <Label
                x:Name="cajaPares"/>
            <Label
                x:Name="cajaImpares"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
