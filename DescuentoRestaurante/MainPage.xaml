<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DescuentoRestaurante.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <Entry Placeholder="Ingrese el total:"
                x:Name="campoTotal"
                Keyboard="Numeric"/> 
            <Button Text="Determinar total a pagar"
                    Clicked="determinarTotal"/>
            <Label Text="Descuento: "
                    x:Name="textoPresentarDescuento"/>
            <Label Text="Impuesto: "
                    x:Name="textoPresentarImpuesto"/>
            <Label Text="Total a pagar: "
                    x:Name="textoPresentarTotal"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>