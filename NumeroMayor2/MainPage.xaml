<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NumeroMayor2.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <Entry Placeholder="Ingrese el primer número:"
                x:Name="primerCampoNumero"
                Keyboard="Numeric"/> 
            <Entry Placeholder="Ingrese el segundo número:"
                x:Name="segundoCampoNumero"
                Keyboard="Numeric"/> 
            <Button Text="Determinar mayor"
                    Clicked="detectarNumeroMayor"/>
            <Label Text="Mayor"
                    x:Name="textoPresentarMayor"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
