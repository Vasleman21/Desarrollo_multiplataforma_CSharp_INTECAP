<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProyeccionAhorro.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <Entry Placeholder="Total"
                    x:Name="campoTotal"
                    Keyboard="Numeric"/>
            <Entry Placeholder="Meses"
                    x:Name="campoMeses"
                    Keyboard="Numeric"/>
            <Button Text="Generar proyección"
                    Clicked="proyeccionAhorro"/>
            <StackLayout
                x:Name="resultadoAhorro"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
