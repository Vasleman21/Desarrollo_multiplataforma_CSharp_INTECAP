<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EstadoCuentaSencillo.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <Entry Placeholder="Ingrese total:"
                    x:Name="campoTotal"
                    Keyboard="Numeric"/>
            <Entry Placeholder="Cantidad de cuotas:"
                    x:Name="campoCuotas"
                    Keyboard="Numeric"/>
            <Button Text="Generar cuotas"
                    Clicked="generarSecuencia"/>
            <StackLayout
                x:Name="cajaTextos"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
